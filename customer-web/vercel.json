{
  "rewrites": [
    { "source": "/c/:slug*", "destination": "/api/card?slug=:slug" },
    { "source": "/pos", "destination": "/pos.html" },
    { "source": "/pos.html", "destination": "/pos.html" },
    { "source": "/api/pos-webhook", "destination": "/api/pos-webhook.js" },
    { "source": "/manifest.json", "destination": "/manifest.json" },
    { "source": "/icon.svg", "destination": "/icon.svg" },
    { "source": "/icon.png", "destination": "/icon.png" },
    { "source": "/favicon.png", "destination": "/favicon.png" },
    { "source": "/flyer.html", "destination": "/flyer.html" }
  ]
}
