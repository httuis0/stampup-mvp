y# ============================================================
# StampUp Environment Variables
# NEVER commit your real .env file with actual keys to git!
# ============================================================

# Your Supabase Project URL (from Supabase Dashboard -> Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Public 'anon' Key (from Supabase Dashboard -> Settings -> API)
# NEVER use the service_role key here!
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Customer Web Page Base URL (for QR code links)
EXPO_PUBLIC_CUSTOMER_WEB_URL=https://stampup.web.app
